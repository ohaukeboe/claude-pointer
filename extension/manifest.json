{
  "manifest_version": 3,
  "name": "Claude Pointer",
  "version": "0.1.0",
  "description": "Pick an element on a web page, comment on it, and send the comment to a running Claude Code session.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-pointer@ohaukeboe",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Claude Pointer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Toggle element pick mode"
    }
  }
}
